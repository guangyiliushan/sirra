---
import Main from "@/layouts/main.astro"
import Icon from "@/components/common/Icon.astro"
import { supportWays, contactLinks } from "@workspace/ui/data/support-data"
---

<Main
  title="Support — Sirra"
  description="Support this project — Buy Me a Coffee, report bugs, suggest features."
>
  <section class="mx-auto max-w-3xl px-4 pt-28 pb-12 text-center">
    <div class="mx-auto mb-6 flex size-20 items-center justify-center rounded-full bg-amber-500/10 text-amber-500">
      <Icon name="coffee" class="size-9" />
    </div>
    <h1 class="text-4xl font-extrabold tracking-tight">Sponsor</h1>
    <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">
      Support this project · このプロジェクトを支援する · 支持这个项目
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 pt-0 pb-12">
    <div class="overflow-hidden rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-500/5 to-amber-600/5 p-8 dark:border-amber-800">
      <div class="flex flex-col items-center gap-8 text-center md:flex-row md:justify-between md:text-left">
        <div class="flex-1">
          <h2 class="text-2xl font-bold tracking-tight">Buy Me a Coffee</h2>
          <p class="mt-2 text-xs text-muted-foreground/70">
            コーヒーを奢る · 请我喝杯咖啡
          </p>
          <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
            If my notes or projects have helped you, consider buying me a coffee.
            <br />
            <span class="text-muted-foreground/70">役に立ったら、コーヒーを一杯おごってください。</span>
            <br />
            <span class="text-muted-foreground/70">如果觉得有帮助，可以请我喝杯咖啡支持创作。</span>
          </p>
          <div class="mt-8 flex justify-center md:justify-start">
            <a
              href="https://www.buymeacoffee.com/guangyiliushan"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png"
                alt="Buy Me a Coffee"
                class="h-[50px] w-[217px]"
              />
            </a>
          </div>
          <p class="mt-4 text-xs text-muted-foreground/60">
            buymeacoffee.com/<strong class="text-foreground/60">guangyiliushan</strong>
          </p>
        </div>

        <div class="shrink-0">
          <div class="rounded-2xl border border-amber-200/60 bg-white p-3 shadow-sm transition-transform hover:scale-105 dark:border-amber-800/60">
            <img
              src="/qr-code.png"
              alt="Buy Me a Coffee QR Code"
              class="size-32 rounded-xl object-contain md:size-40"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="mb-10">
      <h2 class="text-3xl font-bold tracking-tight">Other Ways</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Other ways to support · その他の支援方法 · 其他支持方式
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-3">
      {supportWays.map((way) => (
        <div class="flex flex-col items-center rounded-2xl border border-border bg-card p-6 text-center transition-all hover:-translate-y-0.5 hover:shadow-sm">
          <Icon name={way.icon as any} class="mb-4 size-8 text-muted-foreground" />
          <h3 class="font-semibold">{way.title}</h3>
          <p class="mt-1 text-xs text-muted-foreground/70">{way.subtitle}</p>
          <p class="mt-3 text-sm text-muted-foreground">{way.desc}</p>
          {way.isCopy ? (
            <button
              id="copy-link-btn"
              class="mt-6 inline-flex items-center justify-center gap-2 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              {way.action}
            </button>
          ) : way.href ? (
            <a
              href={way.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex items-center justify-center gap-2 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              {way.action}
            </a>
          ) : null}
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="mb-10">
      <h2 class="text-3xl font-bold tracking-tight">Feedback</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Report bugs or suggest features · バグ報告や機能提案 · 反馈与建议
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {contactLinks.map((link) => (
        <a
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
          class="flex items-start gap-4 rounded-2xl border border-border bg-card p-5 transition-all hover:-translate-y-0.5 hover:shadow-sm"
        >
          <div class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl ${link.iconTint}`}>
            <Icon name={link.icon as any} class="size-5" />
          </div>
          <div class="flex flex-col">
            <h3 class="font-semibold">{link.title}</h3>
            <div class="mt-1 text-sm text-muted-foreground">
              <div class="flex flex-col gap-1">
                <span class="text-xs text-muted-foreground/70">{link.subtitle}</span>
                <span>{link.desc}</span>
              </div>
            </div>
            <span class="mt-2 text-xs font-medium text-primary">{link.cta}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <footer class="border-t border-border px-4 py-12 text-center">
    <p class="text-sm text-muted-foreground">
      Thank you for your support · ご支援ありがとうございます · 感谢你的支持
    </p>
    <p class="mt-2 text-xs text-muted-foreground/60">
      Every coffee, star, issue, and suggestion helps this project grow.
    </p>
  </footer>
</Main>

<script>
  document.getElementById('copy-link-btn')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.origin)
      alert('Link copied! · リンクをコピーしました · 链接已复制')
    } catch {
      alert('Failed to copy')
    }
  })
</script>
