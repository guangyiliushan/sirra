---
import Main from "@/layouts/main.astro"
import Icon from "@/components/common/Icon.astro"
import { knowledgeAreas } from "@workspace/ui/data/knowledge-areas"
---

<Main
  title="Sirra | 学習·研究·創作"
  description="Personal Notes & Knowledge Lab. Mathematics, Science, Languages. Breaking, Rebuilding, Understanding."
>
  <section class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden px-4 pt-20 text-center">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/5 via-background to-background" />

    <p class="text-xs font-medium tracking-widest text-muted-foreground/50 uppercase">
      Notes · Labs · Thoughts | ノート·研究·思考 | 笔记 · 实验 · 思考
    </p>

    <h1 class="mt-6 text-6xl font-extrabold tracking-tight text-foreground sm:text-8xl">
      Sirra
    </h1>

    <p class="mt-4 text-sm leading-relaxed text-muted-foreground/60 sm:text-base">
      <span class="italic">Named after Händel&apos;s Opera &laquo;Silla&raquo;</span>
      <br />
      <span class="italic">ヘンデルのオペラ『シッラ』に由来</span>
      <br />
      <span class="italic">取自亨德尔歌剧《西拉》</span>
    </p>

    <p class="mt-8 max-w-xl text-sm leading-relaxed text-muted-foreground sm:text-base">
      这是我的个人知识实验室 · 学习笔记与思考空间
      <br />
      ここは私の個人知識ラボ·学習ノートと思考の場所
      <br />
      This is my personal knowledge lab, study notes & thinking space
    </p>

    <p class="mt-10 max-w-md text-sm leading-relaxed text-muted-foreground/70">
      科学从不停止反叛。
      <br />
      科学は反逆を止めない。
      <br />
      Science never stops rebelling.
      <br />
      打破旧认知 · 重建新理解 | 旧知を打ち破り、新知を創造する
    </p>

    <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/en/"
        class="inline-flex items-center justify-center gap-2 rounded-md bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
      >
        <Icon name="file-text" class="size-4 shrink-0" />
        翻阅笔记 | View Notes | ノートを読む
      </a>
      <a
        href="#knowledge-areas"
        class="inline-flex items-center justify-center gap-2 rounded-md border border-input bg-background px-6 py-2.5 text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground"
      >
        <Icon name="chevron-down" class="size-4 shrink-0" />
        探索领域 | Explore Areas | 分野を探る
      </a>
    </div>

    <div class="mt-16 flex items-center gap-5 text-xs text-muted-foreground/40">
      <span>中文 / 中国語</span>
      <span class="text-border">&middot;</span>
      <span>English</span>
      <span class="text-border">&middot;</span>
      <span>日本語</span>
    </div>
  </section>

  <section id="knowledge-areas" class="relative pt-12">
    <section class="mx-auto max-w-7xl px-4 py-12">
      <div class="mb-10 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
          研究·学习领域
        </h2>
        <p class="mt-3 max-w-2xl text-muted-foreground">
          Research & Study Areas | 研究·学習分野 | 研究及学习领域
        </p>
      </div>

      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          knowledgeAreas.map((area) => (
            <div class="group relative overflow-hidden rounded-2xl border border-border bg-card/50 p-6 backdrop-blur-sm transition-all hover:-translate-y-1 hover:shadow-xl">
              <div class="flex items-center gap-2">
                <div class="rounded-full bg-primary/10 p-2 text-primary">
                  <Icon name={area.icon as any} class="size-6" />
                </div>
                <h3 class="text-xl font-semibold">{area.title}</h3>
              </div>
              <div class="mt-4 text-sm text-muted-foreground">
                <div class="flex flex-col gap-2">
                  <p>
                    <span class="font-medium text-foreground">
                      {area.description.title}
                    </span>
                    <br />
                    {area.description.titleEn}
                  </p>
                  <p>
                    {area.description.note}
                    <br />
                    {area.description.noteEn}
                  </p>
                  {area.description.quote && (
                    <p class="text-xs italic">
                      &ldquo;{area.description.quote}&rdquo;
                    </p>
                  )}
                </div>
              </div>
              <div class="mt-4 flex flex-wrap gap-2">
                {area.tags.map((tag) => (
                  <span class="inline-flex items-center rounded-md border border-border px-2.5 py-0.5 text-xs font-semibold text-muted-foreground transition-colors">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </section>

  <section class="relative">
    <section class="mx-auto max-w-7xl px-4 py-12">
      <div class="flex items-center justify-between border-b border-border pb-4">
        <h2 class="text-2xl font-semibold tracking-tight">
          最近のノート · Recent Notes
        </h2>
        <a
          href="/"
          class="flex items-center gap-1 text-sm text-muted-foreground transition-all hover:text-primary"
        >
          全て見る - All notes
        </a>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" />
      <div class="mt-6 text-center text-xs text-muted-foreground/60 italic">
        日々更新中 · 随复习新增 MDX · Daily updates with interactive
        visualizations
      </div>
    </section>
  </section>

  <footer class="border-t border-border px-4 py-12 text-center">
    <p class="text-sm text-muted-foreground">
      Sirra — 学习 · 研究 · 創作 | Study · Research · Create |
      学習·研究·創作
    </p>
    <p class="mt-1 text-xs text-muted-foreground/70">
      Built with Astro + React + shadcn/ui | 勉強·研究·創作用ポートフォリオ
    </p>
  </footer>
</Main>
