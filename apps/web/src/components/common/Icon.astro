---
import { renderToString } from "react-dom/server"
import React from "react"
import * as lucide from "lucide-react"

interface Props {
  name: string
  class?: string
  size?: number
}

const { name, class: cls, size } = Astro.props

// kebab-case → PascalCase: "external-link" → "ExternalLink"
const pascalName = name
  .split("-")
  .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
  .join("")

const iconsMap = lucide as unknown as Record<string, React.FC>
const IconComponent = iconsMap[pascalName]

const innerHtml = IconComponent
  ? (() => {
      const html = renderToString(React.createElement(IconComponent, {}))
      const match = html.match(/<svg[^>]*>([\s\S]*)<\/svg>/)
      return match ? match[1].trim() : ""
    })()
  : ""
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  width={size}
  height={size}
  class={cls}
  aria-hidden="true"
  set:html={innerHtml}
/>
