---
import Icon from "@/components/common/Icon.astro"
import { subjectLinks } from "@workspace/ui/data/subjects"

interface NavSubItem {
  label: string
  href: string
  description?: string
}

interface NavItem {
  label: string
  href?: string
  active?: boolean
  children?: NavSubItem[]
}

const pathname = Astro.url.pathname

const localePrefix = pathname.startsWith("/zh-cn/")
  ? "/zh-cn"
  : pathname.startsWith("/ja/")
    ? "/ja"
    : pathname.startsWith("/en/")
      ? "/en"
      : "/en"

const navItems: NavItem[] = [
  { label: "Home", href: "/", active: pathname === "/" },
  {
    label: "Subjects",
    children: subjectLinks.map((s) => ({
      ...s,
      href: `${localePrefix}${s.href}`,
    })),
  },
  {
    label: "About",
    href: "/about",
    active: pathname === "/about" || pathname.startsWith("/about/"),
  },
  {
    label: "Sponsor",
    href: "/sponsor",
    active: pathname === "/sponsor" || pathname.startsWith("/sponsor/"),
  },
]

const logoHtml = `Sirra<span class="text-primary">.</span>`
const searchPlaceholder = "Search knowledge..."
---

<header
  id="app-header"
  data-slot="header-nav"
  class="fixed top-0 right-0 left-0 z-50 flex h-16 items-center border-b border-transparent px-4 transition-all duration-300 bg-background/60 backdrop-blur-lg"
>
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between">
    <div class="flex items-center gap-6">
      <a
        href="/"
        class="flex shrink-0 items-center gap-2 font-semibold text-foreground transition-opacity hover:opacity-80"
      >
        <span class="text-lg font-bold tracking-tight" set:html={logoHtml} />
      </a>

      <nav class="hidden items-center gap-1 md:flex">
        {
          navItems.map((item: NavItem) => {
            if (item.children && item.children.length > 0) {
              return (
                <div class="group/nav-submenu relative">
                  <button
                    type="button"
                    class="inline-flex h-9 items-center gap-1 rounded-3xl px-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                    aria-expanded="false"
                  >
                    {item.label}
                    <span class="size-3 transition-transform duration-200 group-hover/nav-submenu:rotate-180">
                      <Icon name="chevron-down" size={12} />
                    </span>
                  </button>
                  <div class="absolute top-full left-1/2 z-50 mt-2 min-w-52 -translate-x-1/2 overflow-hidden rounded-3xl bg-popover p-1.5 shadow-lg ring-1 ring-foreground/5 transition-all duration-200 dark:ring-foreground/10 invisible -translate-y-1 opacity-0 group-hover/nav-submenu:visible group-hover/nav-submenu:translate-y-0 group-hover/nav-submenu:opacity-100">
                    {item.children.map((child: NavSubItem) => (
                      <a
                        href={child.href}
                        class="flex items-start gap-3 rounded-2xl px-3 py-2.5 text-sm transition-colors hover:bg-muted"
                      >
                        <div class="flex flex-col">
                          <span class="font-medium text-foreground">{child.label}</span>
                          {child.description && (
                            <span class="line-clamp-1 text-xs text-muted-foreground">{child.description}</span>
                          )}
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              )
            }
            return (
              <a
                href={item.href ?? "#"}
                class:list={[
                  "group/nav-link relative inline-flex h-9 items-center rounded-3xl px-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground",
                  { "bg-muted/50 text-foreground": item.active },
                ]}
              >
                {item.label}
                <span
                  class:list={[
                    "absolute right-2.5 bottom-1 left-2.5 h-px origin-left bg-foreground/30 transition-transform duration-300 scale-x-0 group-hover/nav-link:scale-x-100",
                    { "scale-x-100": item.active },
                  ]}
                />
              </a>
            )
          })
        }
      </nav>
    </div>

    <div class="flex items-center gap-2">
      <div id="header-search-wrapper" class="relative hidden items-center transition-all duration-300 md:flex w-10">
        <button
          id="header-search-btn"
          type="button"
          class="absolute left-0 z-10 inline-flex h-9 w-9 items-center justify-center rounded-3xl transition-colors hover:bg-muted"
          aria-label="Toggle search"
        >
          <span class="text-muted-foreground"><Icon name="search" size={16} /></span>
        </button>
        <input
          id="header-search-input"
          type="search"
          placeholder={searchPlaceholder}
          class="h-9 w-full min-w-0 rounded-3xl border border-transparent bg-input/50 pl-9 pr-3 text-sm transition-all outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30 w-0 opacity-0"
        />
      </div>

      <starlight-theme-toggle>
        <button
          type="button"
          class="theme-toggle-btn group/theme-toggle inline-flex h-9 w-9 items-center justify-center rounded-3xl transition-colors hover:bg-muted"
          aria-label="Toggle theme"
        >
          <span class="sun-icon"><Icon name="sun" size={16} /></span>
          <span class="moon-icon"><Icon name="moon" size={16} /></span>
        </button>
      </starlight-theme-toggle>

      <a
        href="/"
        class="inline-flex shrink-0 items-center justify-center rounded-4xl border border-transparent bg-primary text-primary-foreground text-sm font-medium whitespace-nowrap transition-all outline-none select-none h-9 gap-1 px-3 hover:bg-primary/80 active:translate-y-px"
      >
        Start Learning
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-3xl transition-colors hover:bg-muted md:hidden"
        aria-label="Toggle menu"
      >
        <span id="mobile-menu-icon-open" class="flex"><Icon name="menu" size={16} /></span>
        <span id="mobile-menu-icon-close" class="hidden"><Icon name="x" size={16} /></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-overlay" class="fixed inset-0 z-40 bg-foreground/20 backdrop-blur-sm transition-opacity duration-300 md:hidden hidden" aria-hidden="true"></div>

<div id="mobile-menu" class="fixed top-0 right-0 bottom-0 z-50 w-72 bg-background shadow-2xl transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] md:hidden translate-x-full">
  <div class="flex h-16 items-center justify-between border-b px-4">
    <span class="text-sm font-semibold">Menu</span>
    <button
      id="mobile-menu-close"
      type="button"
      class="inline-flex h-9 w-9 items-center justify-center rounded-3xl transition-colors hover:bg-muted"
      aria-label="Close menu"
    >
      <Icon name="x" size={16} />
    </button>
  </div>

  <div class="flex flex-col gap-1 overflow-y-auto p-4">
    <div class="relative mb-3 md:hidden">
      <span class="absolute top-1/2 left-3 -translate-y-1/2 text-muted-foreground">
        <Icon name="search" size={16} />
      </span>
      <input
        type="search"
        placeholder={searchPlaceholder}
        class="h-9 w-full min-w-0 rounded-3xl border border-transparent bg-input/50 py-1 pr-3 pl-9 text-sm transition-all outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30"
      />
    </div>

    {
      navItems.map((item: NavItem) => {
        if (item.children && item.children.length > 0) {
          const submenuId = `mobile-submenu-${item.label.replace(/\s+/g, "-")}`
          return (
            <div class="flex flex-col">
              <button
                type="button"
                data-mobile-submenu-trigger={submenuId}
                class="flex w-full items-center justify-between rounded-2xl px-3 py-2.5 text-sm font-medium transition-colors hover:bg-muted"
              >
                {item.label}
                <span class="mobile-submenu-caret text-muted-foreground transition-transform duration-200">
                  <Icon name="chevron-down" size={16} />
                </span>
              </button>
              <div
                id={submenuId}
                class="ml-3 flex flex-col gap-1 overflow-hidden border-l border-border pl-3 transition-all duration-200 max-h-0 opacity-0"
              >
                {item.children.map((child: NavSubItem) => (
                  <a
                    href={child.href}
                    class="flex items-start gap-2 rounded-2xl px-3 py-2 transition-colors hover:bg-muted"
                  >
                    <div class="flex flex-col">
                      <span class="text-sm font-medium">{child.label}</span>
                      {child.description && (
                        <span class="line-clamp-1 text-xs text-muted-foreground">{child.description}</span>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }
        return (
          <a
            href={item.href ?? "#"}
            class:list={[
              "rounded-2xl px-3 py-2.5 text-sm font-medium transition-colors hover:bg-muted",
              { "bg-muted/50 text-foreground": item.active },
            ]}
          >
            {item.label}
          </a>
        )
      })
    }
  </div>
</div>

<script>
  const STORAGE_KEY = "starlight-theme"

  function getSystemTheme(): "dark" | "light" {
    return matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark"
  }

  function getStoredTheme(): "dark" | "light" {
    try {
      const stored = localStorage.getItem(STORAGE_KEY)
      if (stored === "dark" || stored === "light") return stored
    } catch {}
    return getSystemTheme()
  }

  function applyTheme(theme: "dark" | "light") {
    document.documentElement.dataset.theme = theme
    document.documentElement.classList.toggle("dark", theme === "dark")
  }

  class StarlightThemeToggle extends HTMLElement {
    constructor() {
      super()
      const btn = this.querySelector<HTMLButtonElement>(".theme-toggle-btn")
      if (!btn) return

      applyTheme(getStoredTheme())

      btn.addEventListener("click", () => {
        const current = (document.documentElement.dataset.theme as "dark" | "light" | undefined) || getSystemTheme()
        const next = current === "dark" ? "light" : "dark"
        localStorage.setItem(STORAGE_KEY, next)
        applyTheme(next)
      })
    }
  }

  customElements.define("starlight-theme-toggle", StarlightThemeToggle)

  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    const stored = localStorage.getItem(STORAGE_KEY)
    if (!stored) {
      applyTheme(getSystemTheme())
    }
  })

  function initAppHeader() {
    const header = document.getElementById("app-header")
    if (!header) return

    let ticking = false
    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        const scrolled = window.scrollY > 10
        if (scrolled) {
          header.classList.add("border-border", "bg-background/80", "shadow-sm", "backdrop-blur-xl")
          header.classList.remove("bg-background/60", "backdrop-blur-lg")
        } else {
          header.classList.add("bg-background/60", "backdrop-blur-lg")
          header.classList.remove("border-border", "bg-background/80", "shadow-sm", "backdrop-blur-xl")
        }
        ticking = false
      })
    }
    onScroll()
    window.addEventListener("scroll", onScroll, { passive: true })

    const menuBtn = document.getElementById("mobile-menu-btn")
    const menuClose = document.getElementById("mobile-menu-close")
    const mobileMenu = document.getElementById("mobile-menu")
    const overlay = document.getElementById("mobile-overlay")
    const iconOpen = document.getElementById("mobile-menu-icon-open")
    const iconClose = document.getElementById("mobile-menu-icon-close")

    let mobileOpen = false
    const openMobile = () => {
      mobileOpen = true
      mobileMenu?.classList.remove("translate-x-full")
      overlay?.classList.remove("hidden")
      iconOpen?.classList.add("hidden")
      iconClose?.classList.remove("hidden")
      document.body.style.overflow = "hidden"
    }
    const closeMobile = () => {
      mobileOpen = false
      mobileMenu?.classList.add("translate-x-full")
      overlay?.classList.add("hidden")
      iconOpen?.classList.remove("hidden")
      iconClose?.classList.add("hidden")
      document.body.style.overflow = ""
    }

    menuBtn?.addEventListener("click", () => mobileOpen ? closeMobile() : openMobile())
    menuClose?.addEventListener("click", closeMobile)
    overlay?.addEventListener("click", closeMobile)

    mobileMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMobile)
    })

    document.querySelectorAll<HTMLButtonElement>("[data-mobile-submenu-trigger]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.dataset.mobileSubmenuTrigger
        const target = document.getElementById(targetId || "")
        const caret = btn.querySelector<HTMLElement>(".mobile-submenu-caret")
        if (!target) return

        const isOpen = !target.classList.contains("max-h-0")
        if (isOpen) {
          target.classList.add("max-h-0", "opacity-0")
          target.classList.remove("mt-1", "mb-1", "max-h-96", "opacity-100")
          if (caret) caret.style.transform = "rotate(0deg)"
        } else {
          target.classList.remove("max-h-0", "opacity-0")
          target.classList.add("mt-1", "mb-1", "max-h-96", "opacity-100")
          if (caret) caret.style.transform = "rotate(180deg)"
        }
      })
    })

    const searchWrapper = document.getElementById("header-search-wrapper")
    const searchBtn = document.getElementById("header-search-btn")
    const searchInput = document.getElementById("header-search-input") as HTMLInputElement | null

    let searchFocused = false
    searchBtn?.addEventListener("click", () => {
      searchFocused = !searchFocused
      if (searchFocused) {
        searchWrapper?.classList.add("w-48")
        searchWrapper?.classList.remove("w-10")
        searchBtn?.classList.add("pointer-events-none")
        searchInput?.classList.remove("w-0", "opacity-0")
        searchInput?.classList.add("opacity-100")
        setTimeout(() => searchInput?.focus(), 50)
      } else {
        searchWrapper?.classList.add("w-10")
        searchWrapper?.classList.remove("w-48")
        searchBtn?.classList.remove("pointer-events-none")
        searchInput?.classList.add("w-0", "opacity-0")
        searchInput?.classList.remove("opacity-100")
        if (searchInput) searchInput.value = ""
      }
    })

    searchInput?.addEventListener("blur", () => {
      if (!searchInput.value) {
        searchFocused = false
        searchWrapper?.classList.add("w-10")
        searchWrapper?.classList.remove("w-48")
        searchBtn?.classList.remove("pointer-events-none")
        searchInput?.classList.add("w-0", "opacity-0")
        searchInput?.classList.remove("opacity-100")
      }
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAppHeader)
  } else {
    initAppHeader()
  }
</script>

<style>
  .theme-toggle-btn {
    position: relative;
  }

    starlight-theme-toggle {
    display: contents;
  }

  .sun-icon,
  .moon-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s, opacity 0.3s;
    color: var(--sl-color-gray-2);
  }

  .sun-icon {
    transform: rotate(0) scale(1);
    opacity: 1;
  }

  .moon-icon {
    transform: rotate(-90deg) scale(0);
    opacity: 0;
  }

  :global([data-theme="dark"]) .sun-icon {
    transform: rotate(90deg) scale(0);
    opacity: 0;
  }

  :global([data-theme="dark"]) .moon-icon {
    transform: rotate(0) scale(1);
    opacity: 1;
  }
</style>
